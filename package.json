{
  "name": "lyra-aria-mobile",
  "productName": "深空折韵",
  "version": "0.1.0",
  "description": "深空折韵 · Android 版（Capacitor UI + 原生播放核）",
  "private": true,
  "type": "module",
  "scripts": {
    "cap:init": "cap init 深空折韵 com.lyraaria.mobile --web-dir web",
