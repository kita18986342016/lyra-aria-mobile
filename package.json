    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "apk": "cd android && gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/android": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
